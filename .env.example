# Backend API base URL (no trailing slash).
# Prefer VITE_API_BASE_URL for local; VITE_BACKEND_API_URL is also accepted.
#
# Local:
#   VITE_API_BASE_URL=http://127.0.0.1:8003
#
# Vercel (production): set ONE remote URL — do NOT set localhost on Vercel:
#   VITE_API_BASE_URL=https://shafsky-backend-1.onrender.com
#   or VITE_BACKEND_API_URL=https://shafsky-backend-1.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8003
